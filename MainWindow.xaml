<Window x:Class="NovaIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Ideal"
        Width="230"
        Height="60"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- Apple-inspired transport controls: minimal, round, tactile. -->
 <Style x:Key="QuickTileArrowButtonStyle"
       TargetType="{x:Type Button}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#FFB8B8BE"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
                <Border Background="Transparent"
                        CornerRadius="9">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>       
<Style x:Key="TransportButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">

                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="18"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="Scale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter TargetName="Chrome"
                                Property="Background"
                                Value="#30FFFFFF"/>

                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1.07"
                                        Duration="0:0:0.12"/>

                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1.07"
                                        Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>

                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1"
                                        Duration="0:0:0.15"/>

                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>

                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome"
                                Property="Background"
                                Value="#55FFFFFF"/>
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome"
                                Property="Opacity"
                                Value="0.35"/>
                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


        
<Style x:Key="PlayButtonStyle" TargetType="Button">

    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Background" Value="#FFF5F5F7"/>
    <Setter Property="Foreground" Value="#FF09090D"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>

    <Setter Property="Template">
        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="22"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="Scale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter TargetName="Chrome"
                                Property="Background"
                                Value="White"/>

                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1.06"
                                        Duration="0:0:0.12"/>

                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1.06"
                                        Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>

                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1"
                                        Duration="0:0:0.15"/>

                                    <DoubleAnimation
                                        Storyboard.TargetName="Scale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>

                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">

                        <Setter TargetName="Chrome"
                                Property="Background"
                                Value="#FFDADAE0"/>

                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">

                        <Setter TargetName="Chrome"
                                Property="Opacity"
                                Value="0.35"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>
    </Setter>

</Style>


        <Style x:Key="PageDotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
<Style x:Key="QuickTileButtonStyle" TargetType="Button">

    <Setter Property="Background" Value="#FF202026"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#24FFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="False"/>

    <Setter Property="Template">
        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border x:Name="TileChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14"
                        Padding="{TemplateBinding Padding}">

                    <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                </Border>

                <ControlTemplate.Triggers>

                    <!-- Hover effect -->

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter TargetName="TileChrome"
                                Property="Background"
                                Value="#FF303038"/>

                        <Setter TargetName="TileChrome"
                                Property="BorderBrush"
                                Value="#66FFFFFF"/>

                    </Trigger>


                    <!-- Press effect -->

                    <Trigger Property="IsPressed" Value="True">

                        <Setter TargetName="TileChrome"
                                Property="Background"
                                Value="#FF45454F"/>

                    </Trigger>


                    <!-- Disabled state -->

                    <Trigger Property="IsEnabled" Value="False">

                        <Setter TargetName="TileChrome"
                                Property="Opacity"
                                Value="0.42"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>
    </Setter>

</Style>


        <!-- Filled vertical slider track, styled like Apple's Control Centre. -->
       


<Style x:Key="AppleVerticalSliderStyle" TargetType="{x:Type Slider}">

    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="148"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="IsDirectionReversed" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="SmallChange" Value="1"/>
    <Setter Property="LargeChange" Value="1"/>
    <Setter Property="IsSnapToTickEnabled" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">

                <Border Background="#FF303036"
                        CornerRadius="23"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">

                    <Track x:Name="PART_Track"
                           Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{Binding Value,
                               RelativeSource={RelativeSource TemplatedParent},
                               Mode=TwoWay}"
                           IsDirectionReversed="False"
                           Margin="2,3">

                        <!-- Filled portion -->
                        <Track.DecreaseRepeatButton>
                            <RepeatButton
                                Command="{x:Static Slider.DecreaseLarge}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="#FFF5F5F7"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                Delay="0"
                                Interval="1">

                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="21"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>

                            </RepeatButton>
                        </Track.DecreaseRepeatButton>

                        <!-- Invisible drag area -->
                        <Track.Thumb>
                            <Thumb Width="42"
                                   Height="10"
                                   Background="Transparent"
                                   BorderThickness="0">

                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>

                            </Thumb>
                        </Track.Thumb>

                        <!-- Unfilled portion -->
                        <Track.IncreaseRepeatButton>
                            <RepeatButton
                                Command="{x:Static Slider.IncreaseLarge}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="#FF303036"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                Delay="0"
                                Interval="1">

                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="21"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>

                            </RepeatButton>
                        </Track.IncreaseRepeatButton>

                    </Track>

                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>

</Style>




        <Style x:Key="AppleSeekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Height="4" VerticalAlignment="Center"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Height="4" VerticalAlignment="Center"
                                                  Background="#FF414149"
                                                  BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF292930" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF383840" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
    <Border x:Name="IslandShell"
            CornerRadius="30"
            Background="#FF0A0A0D"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="12"
            ClipToBounds="True">

        <Grid>
            <!-- COMPACT ISLAND: remains visible while collapsed -->
            <Grid x:Name="CompactView" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <Border Width="36" Height="36"
                        CornerRadius="11"
                        Background="#FF202027"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="CompactAlbumArt" Stretch="UniformToFill" />
                        <TextBlock x:Name="CompactArtPlaceholder"
                                   Text="♫" Foreground="White" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,4,0">
                    <TextBlock x:Name="CompactTitle"
                               Text="Nothing playing"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CompactArtist"
                               Text="Nothing playing"
                               Foreground="#FFB8B8BE"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Height="30">
                    <Rectangle x:Name="CompactWaveBar1" Width="3" Height="5" RadiusX="2" RadiusY="2" Fill="White" Margin="1" VerticalAlignment="Center" />
                    <Rectangle x:Name="CompactWaveBar2" Width="3" Height="8" RadiusX="2" RadiusY="2" Fill="White" Margin="1" VerticalAlignment="Center" />
                    <Rectangle x:Name="CompactWaveBar3" Width="3" Height="13" RadiusX="2" RadiusY="2" Fill="White" Margin="1" VerticalAlignment="Center" />
                    <Rectangle x:Name="CompactWaveBar4" Width="3" Height="8" RadiusX="2" RadiusY="2" Fill="White" Margin="1" VerticalAlignment="Center" />
                    <Rectangle x:Name="CompactWaveBar5" Width="3" Height="5" RadiusX="2" RadiusY="2" Fill="White" Margin="1" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- EXPANDED ISLAND -->
            <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header; this waveform is global and stays visible on every page -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="2,0,4,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText"
                               Text="MUSIC &amp; LYRICS"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Rectangle x:Name="GlobalWaveBar1" Width="2" Height="4" Fill="White" RadiusX="1" RadiusY="1" Margin="1" VerticalAlignment="Center" />
                        <Rectangle x:Name="GlobalWaveBar2" Width="2" Height="7" Fill="White" RadiusX="1" RadiusY="1" Margin="1" VerticalAlignment="Center" />
                        <Rectangle x:Name="GlobalWaveBar3" Width="2" Height="11" Fill="White" RadiusX="1" RadiusY="1" Margin="1" VerticalAlignment="Center" />
                        <Rectangle x:Name="GlobalWaveBar4" Width="2" Height="7" Fill="White" RadiusX="1" RadiusY="1" Margin="1" VerticalAlignment="Center" />
                        <Rectangle x:Name="GlobalWaveBar5" Width="2" Height="4" Fill="White" RadiusX="1" RadiusY="1" Margin="1" VerticalAlignment="Center" />
                    </StackPanel>

                </Grid>

                <!-- PAGE HOST: all six pages occupy the same space -->
                <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="0"
                      ClipToBounds="True" Margin="0,2,5,0">

                    <!-- PAGE 1: MUSIC & LYRICS -->
                    <Grid x:Name="PageMusic" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="96" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="86" Height="86"
                                    CornerRadius="15"
                                    Background="#FF202027"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ExpandedAlbumArt" Stretch="UniformToFill" />
                                    <TextBlock x:Name="ExpandedArtPlaceholder"
                                               Text="♫" Foreground="White" FontSize="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,2,0">
                                <TextBlock x:Name="ExpandedTitle"
                                           Text="Nothing playing"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ExpandedArtist"
                                           Text="Start music on your PC"
                                           Foreground="#FFB8B8BE"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ExpandedAlbum"
                                            Text="Media player"
                                           Foreground="#FF85858D"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- Apple-style transport buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Margin="4,0" ToolTip="Previous track" Click="Previous_Click">
                                <Path Data="M 16,4 L 7,12 L 16,20 Z M 4,4 H 6 V 20 H 4 Z"
                                      Fill="White" Width="19" Height="19" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource PlayButtonStyle}"
                                    Margin="9,0"
                                    IsEnabled="False"
                                    ToolTip="Play or pause"
                                    Click="PlayPause_Click" />
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Margin="4,0" ToolTip="Next track" Click="Next_Click">
                                <Path Data="M 8,4 L 17,12 L 8,20 Z M 18,4 H 20 V 20 H 18 Z"
                                      Fill="White" Width="19" Height="19" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!-- Seek bar and duration -->
                        <Grid Grid.Row="2" Margin="2,1,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                            <Slider x:Name="SeekSlider"
                                    Style="{StaticResource AppleSeekSliderStyle}"
                                    Grid.Row="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    IsEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    Foreground="White"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                            <TextBlock x:Name="PositionText"
                                       Grid.Row="1"
                                       Text="0:00"
                                       Foreground="#FFB8B8BE"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DurationText"
                                       Grid.Row="1"
                                       Text="--:--"
                                       Foreground="#FFB8B8BE"
                                       FontSize="9"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Current lyric line; synchronized lyrics are a later service -->
                        <Border Grid.Row="3"
                                Background="#FF17171D"
                                CornerRadius="10"
                                Padding="9,5"
                                Margin="1,1,1,0">
                            <TextBlock x:Name="CurrentLyricText"
                                       Text="Lyrics will appear here when available"
                                       Foreground="White"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>

                    <!-- PAGE 2: SYSTEM MONITOR -->
                    <Grid x:Name="PageSystem" Visibility="Collapsed" Margin="2,6,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#FF17171D" CornerRadius="13" Padding="12" Margin="0,0,5,5">
                            <StackPanel>
                                <TextBlock Text="CPU USAGE" Foreground="#FFB8B8BE" FontSize="10" />
                                <TextBlock x:Name="CpuUsageText" Text="--%" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="Processor" Foreground="#FF85858D" FontSize="9" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#FF17171D" CornerRadius="13" Padding="12" Margin="5,0,0,5">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Foreground="#FFB8B8BE" FontSize="10" />
                                <TextBlock x:Name="RamUsageText" Text="--%" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="RAM usage" Foreground="#FF85858D" FontSize="9" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#FF17171D" CornerRadius="13" Padding="12" Margin="0,5,5,0">
                            <StackPanel>
                                <TextBlock Text="GPU" Foreground="#FFB8B8BE" FontSize="10" />
                                <TextBlock x:Name="GpuUsageText" Text="--%" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="Graphics processor" Foreground="#FF85858D" FontSize="9" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#FF17171D" CornerRadius="13" Padding="12" Margin="5,5,0,0">
                            <StackPanel>
                                <TextBlock Text="BATTERY" Foreground="#FFB8B8BE" FontSize="10" />
                                <TextBlock x:Name="BatteryPercentText" Text="--%" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="BatteryStatusText" Text="Power status" Foreground="#FF85858D" FontSize="9" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PAGE 3: DATE, TIME & CALENDAR -->
                    <Grid x:Name="PageCalendar" Visibility="Collapsed" Margin="5,10,5,5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText"
                                       Text="--:--:--"
                                       Foreground="White"
                                       FontSize="43"
                                       FontWeight="Light"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DateText"
                                       Text="Loading date..."
                                       Foreground="#FFB8B8BE"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,15" />
                            <Border Background="#FF17171D" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="UPCOMING" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Calendar and reminders will appear here."
                                               Foreground="#FFB8B8BE" FontSize="11" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- PAGE 4: APPLE-INSPIRED CONTROL CENTRE -->
                    <Grid x:Name="PageQuickSettings" Visibility="Collapsed" Margin="2,6,2,2">

                        <!-- Main Control Centre -->
                        <Grid x:Name="QuickSettingsHome" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="52" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <!-- Connectivity tile group -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#FF1A1A20"
                                    CornerRadius="21" Padding="9" Margin="0,0,7,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    
<Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="27"/>
    </Grid.ColumnDefinitions>

    <!-- Main Wi-Fi toggle -->
    <Button x:Name="WifiRadioButton"
            Grid.Column="0"
            Style="{StaticResource QuickTileButtonStyle}"
            Click="WifiRadioToggle_Click">

        <StackPanel Orientation="Horizontal">
            <Border x:Name="WifiIconCircle"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    Background="#FF303038">

                <TextBlock x:Name="WifiRadioIcon"
                           Text="&#xE701;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="7,0,0,0">
                <TextBlock x:Name="WifiRadioLabel"
                           Text="Wi-Fi"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="CurrentWifiText"
                           Text="Checking..."
                           Foreground="#FFB8B8BE"
                           FontSize="9"
                           MaxWidth="85"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </Button>

    <!-- Arrow opens available networks -->
    <Button Grid.Column="1"
        Style="{StaticResource QuickTileArrowButtonStyle}"
        Content="›"
        FontSize="21"
        Click="WifiTile_Click"
        ToolTip="Available networks"/>
</Grid>

                                    
<Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="27"/>
    </Grid.ColumnDefinitions>

    <!-- Main Bluetooth toggle -->
    <Button x:Name="BluetoothRadioButton"
            Grid.Column="0"
            Style="{StaticResource QuickTileButtonStyle}"
            Click="BluetoothRadioToggle_Click">

        <StackPanel Orientation="Horizontal">
            <Border x:Name="BluetoothIconCircle"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    Background="#FF303038">

                <TextBlock x:Name="BluetoothRadioIcon"
                           Text="&#xE702;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="7,0,0,0">
                <TextBlock x:Name="BluetoothRadioLabel"
                           Text="Bluetooth"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"/>

                 <TextBlock x:Name="BluetoothRadioStatusText"
                           Text="Checking..."
                           Foreground="#FFB8B8BE"
                            FontSize="9" MaxWidth="85" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </Button>

    <!-- Arrow opens available devices -->
    <Button Grid.Column="1"
        Style="{StaticResource QuickTileArrowButtonStyle}"
        Content="›"
        FontSize="21"
        Click="BluetoothTile_Click"
        ToolTip="Available devices"/>
</Grid>


                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource QuickTileButtonStyle}"
                                            Margin="0,4,4,0" Click="ToggleHotspot_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#FF303038" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="Hotspot" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="Personal" Foreground="#FFB8B8BE" FontSize="9" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickTileButtonStyle}"
                                            Margin="4,4,0,0" Click="OpenAirplaneSettings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#FF303038" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="Airplane" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="Mode" Foreground="#FFB8B8BE" FontSize="9" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Brightness slider -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#FF1A1A20"
                                    CornerRadius="23" Margin="0,0,6,7" Padding="4">
                                <Grid>
                                    <Slider x:Name="BrightnessSlider" Style="{StaticResource AppleVerticalSliderStyle}"
                                            Value="0" ValueChanged="BrightnessSlider_ValueChanged"
                                            ToolTip="Display brightness" />
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#FF111116" HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom" Margin="0,0,0,12"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- Volume slider -->
                            <Border Grid.Row="0" Grid.Column="2" Background="#FF1A1A20"
                                    CornerRadius="23" Margin="0,0,0,7" Padding="4">
                                <Grid>
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource AppleVerticalSliderStyle}"
                                            Value="0" ValueChanged="VolumeSlider_ValueChanged"
                                            ToolTip="System volume" />
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#FF111116" HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom" Margin="0,0,0,12"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- Value labels and other quick toggles -->
                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#FF1A1A20"
                                    CornerRadius="17" Padding="7,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource QuickTileButtonStyle}"
                                            Background="Transparent" BorderThickness="0" Padding="5,3"
                                            Click="OpenNightLightSettings_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text=" Night Light" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource QuickTileButtonStyle}"
                                            Background="Transparent" BorderThickness="0" Padding="5,3"
                                            Click="OpenSoundSettings_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock x:Name="VolumeValueText" Text="55%" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource QuickTileButtonStyle}"
                                            Background="Transparent" BorderThickness="0" Padding="5,3"
                                            Click="OpenDisplaySettings_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock x:Name="BrightnessValueText" Text="70%" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Wi-Fi network picker -->
                        <Grid x:Name="WifiPickerPanel" Visibility="Collapsed">
                            <Border Background="#FF15151B" CornerRadius="19" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="‹" Width="30" Height="30" FontSize="23" Foreground="White" Background="#FF292930" BorderThickness="0" Click="BackFromWifi_Click" />
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Wi-Fi Networks" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WifiStatusText" Text="Scanning nearby networks…" Foreground="#FFB8B8BE" FontSize="10" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="32" Height="30" Foreground="White" Background="#FF292930" BorderThickness="0" Click="RefreshWifi_Click" ToolTip="Refresh networks" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" x:Name="WifiCurrentSsidText" Text="" Foreground="#FFB8B8BE" FontSize="10" Margin="3,8,3,5" />
                                    <ListBox x:Name="WifiNetworksList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                             Foreground="White" ItemContainerStyle="{StaticResource PickerListBoxItemStyle}"
                                             SelectionChanged="WifiNetworksList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Ssid}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SecurityLabel}" Foreground="#FFB8B8BE" FontSize="9" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SignalLabel}" Foreground="#FFB8B8BE" FontSize="9" Margin="0,0,7,0" />
                                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB8B8BE" FontSize="12" Visibility="{Binding LockVisibility}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="3" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="WifiPasswordBox" Visibility="Collapsed" Height="34" Padding="9,6" Background="#FF25252D" Foreground="White" BorderBrush="#44FFFFFF" BorderThickness="1" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Settings" Height="34" Margin="7,0,0,0" Padding="10,0" Background="#FF292930" Foreground="White" BorderThickness="0" Click="OpenWifiSettings_Click" />
                                        <Button x:Name="WifiConnectButton" Grid.Column="2" Content="Join" IsEnabled="False" MinWidth="76" Height="34" Margin="7,0,0,0" Background="White" Foreground="#FF111116" BorderThickness="0" FontWeight="SemiBold" Click="ConnectWifi_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bluetooth device picker -->
                        <Grid x:Name="BluetoothPickerPanel" Visibility="Collapsed">
                            <Border Background="#FF15151B" CornerRadius="19" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="‹" Width="30" Height="30" FontSize="23" Foreground="White" Background="#FF292930" BorderThickness="0" Click="BackFromBluetooth_Click" />
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Bluetooth Devices" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="BluetoothStatusText" Text="Looking for nearby devices…" Foreground="#FFB8B8BE" FontSize="10" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="32" Height="30" Foreground="White" Background="#FF292930" BorderThickness="0" Click="RefreshBluetooth_Click" ToolTip="Refresh devices" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="NEARBY &amp; PAIRED" Foreground="#FF85858D" FontSize="9" FontWeight="Bold" Margin="3,9,3,4" />
                                    <ListBox x:Name="BluetoothListBox" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                             Foreground="White" ItemContainerStyle="{StaticResource PickerListBoxItemStyle}"
                                             SelectionChanged="BluetoothListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StateLabel}" Foreground="#FFB8B8BE" FontSize="9" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ActionLabel}" Foreground="#FFB8B8BE" FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="3" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BluetoothFooterText" Text="Select a device to pair." Foreground="#FFB8B8BE" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Settings" Height="34" Margin="7,0,0,0" Padding="10,0" Background="#FF292930" Foreground="White" BorderThickness="0" Click="OpenBluetoothSettings_Click" />
                                        <Button x:Name="PairBluetoothButton" Grid.Column="2" Content="Pair" IsEnabled="False" MinWidth="76" Height="34" Margin="7,0,0,0" Background="White" Foreground="#FF111116" BorderThickness="0" FontWeight="SemiBold" Click="PairBluetooth_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- PAGE 5: NOTIFICATIONS -->
                    <Grid x:Name="PageNotifications" Visibility="Collapsed" Margin="4,8,4,4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NOTIFICATIONS" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows notifications will appear here after notification access is configured."
                                       Foreground="#FFB8B8BE" FontSize="11" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="12,12,12,0" />
                        </StackPanel>
                    </Grid>

                    <!-- PAGE 6: DEVICES & ALERTS -->
                    <Grid x:Name="PageDevices" Visibility="Collapsed" Margin="4,8,4,4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DEVICES &amp; ALERTS" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Charger, battery and external-device alerts will appear here when their Windows services are connected."
                                       Foreground="#FFB8B8BE" FontSize="11" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="12,12,12,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- VERTICAL PAGE DOTS -->
                <StackPanel x:Name="PageDotsPanel"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="0" Click="PageDot_Click"><Border x:Name="PageDot0" Width="6" Height="14" CornerRadius="3" Background="White" /></Button>
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="1" Click="PageDot_Click"><Border x:Name="PageDot1" Width="6" Height="6" CornerRadius="3" Background="#66FFFFFF" /></Button>
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="2" Click="PageDot_Click"><Border x:Name="PageDot2" Width="6" Height="6" CornerRadius="3" Background="#66FFFFFF" /></Button>
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="3" Click="PageDot_Click"><Border x:Name="PageDot3" Width="6" Height="6" CornerRadius="3" Background="#66FFFFFF" /></Button>
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="4" Click="PageDot_Click"><Border x:Name="PageDot4" Width="6" Height="6" CornerRadius="3" Background="#66FFFFFF" /></Button>
                    <Button Style="{StaticResource PageDotButtonStyle}" Tag="5" Click="PageDot_Click"><Border x:Name="PageDot5" Width="6" Height="6" CornerRadius="3" Background="#66FFFFFF" /></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
